# Ключ модели. Один из двух вариантов; без обоих приложение работает в режиме просмотра данных, агент недоступен.
# Вариант 1, основной: ключ OpenAI (перк из кабинета или свой с platform.openai.com).
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.6-terra

# Вариант 2, если ключа OpenAI нет: ключ NVIDIA из перков (build.nvidia.com, начинается с nvapi-).
# Тогда AGENT_MODEL это id модели со страницы build.nvidia.com, у которой есть function calling, например meta/llama-3.3-70b-instruct.
# NVIDIA_API_KEY=
# AGENT_MODEL=meta/llama-3.3-70b-instruct

# Необязательно
AGENT_MODEL_DEEP=gpt-6-astra
OPENAI_API_KEY_FALLBACK=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

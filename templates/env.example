# Ключ модели. Один из двух вариантов; без обоих приложение работает в режиме просмотра данных, агент недоступен.
# Вариант 1, основной: ключ OpenAI (перк из кабинета или свой с platform.openai.com).
# На развёрнутой версии (Vercel) — только СВОЙ ключ: перк-ключ могут отозвать после события, а эксперты проверяют 24–28.09.
OPENAI_API_KEY=
AGENT_MODEL=gpt-6-sol
# Глубина рассуждения: none | minimal | low | medium | high | xhigh | max. Выбирать замером: самое высокое, при котором сценарий < 30 с.
AGENT_REASONING=low

# Вариант 2, если ключа OpenAI нет: ключ NVIDIA из перков (build.nvidia.com, начинается с nvapi-).
# Тогда AGENT_MODEL это id модели со страницы build.nvidia.com, у которой есть function calling, например meta/llama-3.3-70b-instruct.
# NVIDIA_API_KEY=
# AGENT_MODEL=meta/llama-3.3-70b-instruct

# Необязательно
AGENT_MODEL_DEEP=gpt-6-astra
OPENAI_API_KEY_FALLBACK=
# Локально не нужны (файл data/app.db). На Vercel ОБЯЗАТЕЛЬНЫ: без них у каждого экземпляра функции своя база в памяти.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Лимиты запусков агента, действуют только на Vercel.
AGENT_RUNS_PER_IP_HOUR=10
AGENT_RUNS_PER_DAY=100
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
